{
  "name": "@ssh-explorer/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/unit/*.test.ts",
    "test:e2e": "tsx --test test/e2e/*.test.ts",
    "test:all": "tsx --test test/unit/*.test.ts test/e2e/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.3",
    "yazl": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@types/yazl": "^2.4.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "author": "Andrew Woolfi | Андрей Павлов <zxcadsl@gmail.com>"
}

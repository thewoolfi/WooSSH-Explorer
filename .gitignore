# Dependencies and build output — regenerated by npm, never edited by hand.
node_modules/
server/dist/
web/dist/
desktop/build/

# Packaged applications: ~90 MB each, they belong in a release, not in history.
release/
*.blockmap

# Runtime state of a local run. `secrets.json` lives here, encrypted or not.
.ssh-explorer-qa/
.ssh-explorer/

# Scratch trees the QA driver and the mock SSH server create.
.mock-ssh-root/
.mock-ssh-root2/

# Artefacts of a QA run: they change on every run and describe one machine.
design/qa/mock.json
design/qa/mock2.json
design/qa/*-smoke.json
design/qa/*-e2e.json
design/qa/qa-run.txt
design/qa/qa2.txt

# Code-graph index.
.codebase-memory/

# Editor and OS noise.
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log

# Never commit a real key, a real host list or a decrypted secret. The names are listed
# so that an accident is refused rather than noticed later.
secret.key
id_rsa
id_ed25519
